# ==============================================================================
#  CONTROLE FINANCEIRO V4 — CONFIGURAÇÃO DE **PRODUÇÃO** (Docker Compose)
# ==============================================================================
#  Este arquivo configura o deploy via `docker compose up --build -d`.
#  Para rodar em modo DEV local (sem Docker), veja backend/.env.example.
#
#  Como usar:   cp .env.example .env   e preencha os campos [OBRIGATÓRIA].
#  Guia completo com passo a passo: SETUP.md
#
#  Legenda:  [OBRIGATÓRIA] precisa preencher   [OPCIONAL] pode deixar vazio
# ==============================================================================


# ------------------------------------------------------------------------------
# 1) BANCO DE DADOS  — [OBRIGATÓRIA: POSTGRES_PASSWORD]
# ------------------------------------------------------------------------------
# ATENÇÃO: defina a senha ANTES do primeiro `docker compose up`. O Postgres
# grava as credenciais no volume na primeira subida; trocar depois exige
# ALTER USER manual ou recriar o volume (perdendo os dados).
# Gerar senha:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=cf4
POSTGRES_PASSWORD=
POSTGRES_DB=controle_financeiro


# ------------------------------------------------------------------------------
# 2) SEGURANÇA  — [OBRIGATÓRIA: SECRET_KEY]
# ------------------------------------------------------------------------------
# Assina os tokens de sessão (JWT). Em produção o backend RECUSA SUBIR se a
# chave for curta (<32 chars) ou padrão. Se vazar, troque (invalida sessões).
# Gerar:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Primeiro administrador do site — [OBRIGATÓRIA em production/staging]
# É a conta que administra tudo (pessoas, convites, configuração) e a ÚNICA que
# consegue se cadastrar sem convite no primeiro acesso. Sem ela o sistema nasce
# inoperável: o cadastro é por convite e não há quem convide — por isso o backend
# recusa subir se estiver vazia.
#
# Depois de subir: acesse /register com ESTE e-mail, crie sua conta, e você já
# entra como superadministrador. A partir daí a exceção fecha sozinha.
SUPERADMIN_EMAIL=


# ------------------------------------------------------------------------------
# 3) AMBIENTE E COOKIES  — [OBRIGATÓRIA: escolher o cenário]
# ------------------------------------------------------------------------------
# Cenário A — COM HTTPS (domínio + TLS na frente):     <- recomendado
#     APP_ENV=production   e   COOKIE_SECURE=True
#
# Cenário B — SEM HTTPS (http:// puro em IP de rede local):
#     APP_ENV=staging      e   COOKIE_SECURE=False
#     (com Secure=True em http://, o navegador descarta o cookie e o
#      login NÃO funciona — exceto em localhost)
APP_ENV=production
COOKIE_SECURE=True

# Fuso do CALENDÁRIO do app: define que dia é "hoje" e onde um mês começa e
# termina (fatura vencida, mês do caixa, materialização de recorrência). Era um
# contrato implícito — só existia como `TZ` nos serviços do compose, invisível
# para a aplicação. Deixe igual ao fuso de quem usa o sistema.
APP_TIMEZONE=America/Sao_Paulo
# `TZ` continua valendo para o RELÓGIO do container (logs, cron). Mantenha os
# dois iguais para não ter duas noções de "hoje" no mesmo host.
TZ=America/Sao_Paulo


# ------------------------------------------------------------------------------
# 4) REDE  — [OBRIGATÓRIA: FRONTEND_URL]
# ------------------------------------------------------------------------------
# FRONTEND_URL = a URL pública que as pessoas digitam no navegador.
# Usada nos links de email (convite/reset de senha) e no redirect do Google.
# Exemplos: https://financas.seudominio.com | http://192.168.1.50
FRONTEND_URL=http://localhost

# Porta HTTP exposta pelo nginx do compose (80 = padrão web)
HTTP_PORT=80

# Em qual interface a porta acima é publicada.
#   0.0.0.0    (padrão) — acessível de fora. Use quando NÃO houver proxy TLS.
#   127.0.0.1            — só o próprio servidor alcança. Use SEMPRE que houver
#                          Caddy/Traefik/nginx terminando HTTPS no host, senão o
#                          aplicativo continua respondendo em http:// na porta
#                          direta e o TLS vira opcional para quem souber a porta.
BIND_ADDR=0.0.0.0

# Cloudflare Tunnel (opcional). Obtenha o token no painel em Networking >
# Tunnels. Para usá-lo em todos os comandos normais do Compose, preencha AS DUAS
# linhas abaixo. Deixe ambas vazias se usar acesso direto, Caddy, Traefik ou
# outro proxy. Alternativa pontual: `docker compose --profile cloudflare up`.
# O token é uma CREDENCIAL: não o commite nem envie por mensagem; quem o possui
# consegue iniciar outra réplica do seu Tunnel. Em Linux, use `chmod 600 .env`.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# Deixe VAZIO: frontend e API saem da mesma origem via nginx (sem CORS).
# Só preencha se um dia servir o frontend de outro domínio.
CORS_ORIGINS=

# Host(s) confiável(is) — [OBRIGATÓRIA em APP_ENV=production]
# Fixa o cabeçalho Host aceito (anti-Host forjado). Em produção o backend RECUSA
# subir com "*"/vazio; informe o(s) domínio(s) reais, separados por vírgula.
# (localhost é sempre aceito internamente, para o healthcheck do container.)
# Em APP_ENV=staging (rede local por IP) pode deixar vazio.
# Ex.: ALLOWED_HOSTS=app.seudominio.com,www.seudominio.com
ALLOWED_HOSTS=


# ------------------------------------------------------------------------------
# 5) GOOGLE OAUTH  — [OPCIONAL — vazio desativa o botão "Entrar com Google"]
# ------------------------------------------------------------------------------
# Como obter (5 min):
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create Credentials -> OAuth client ID -> Web application
#   3. Em "Authorized redirect URIs" use exatamente:
#      <FRONTEND_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=


# ------------------------------------------------------------------------------
# 6) EMAIL / SMTP  — [OPCIONAL — vazio = links saem no log do backend]
# ------------------------------------------------------------------------------
# Sem SMTP_HOST, convites e reset de senha aparecem em:
#     docker compose logs backend
# (você copia o link e envia manualmente — funciona, só é menos prático)
#
# Gmail: ative verificação em 2 etapas e gere uma "senha de app" em
# https://myaccount.google.com/apppasswords (NÃO use a senha da conta):
#     SMTP_HOST=smtp.gmail.com   SMTP_USER=voce@gmail.com
#     SMTP_PASSWORD=<senha de app de 16 letras>
#
# Resend (domínio verificado):
#     SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend
#     SMTP_PASSWORD=<API key>    EMAIL_FROM=Controle Financeiro <noreply@seudominio.com>
#
# SPF, DKIM e DMARC são registros DNS configurados no provedor/Cloudflare; não
# são segredos nem variáveis desta aplicação e, por isso, NÃO entram no `.env`.
# Este backend usa STARTTLS (`SMTP_TLS=True`, normalmente porta 587). Ele não
# suporta SSL implícito da porta 465; `False` significa envio sem STARTTLS.
# [OBRIGATÓRIA quando SMTP_HOST estiver preenchido] Remetente aceito pelo
# provedor e pertencente ao domínio verificado.
# Aceita endereço puro ou nome de exibição: Controle Financeiro <noreply@seudominio.com>
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True


# ------------------------------------------------------------------------------
# 7) LIMITES  — [OPCIONAL — os padrões servem]
# ------------------------------------------------------------------------------
# Anti força-bruta em login/registro/recuperação de senha. São DOIS baldes por
# minuto: um por IP+rota e outro por CONTA alvo. O de IP é o mais generoso de
# propósito — um IP é compartilhado por todo mundo atrás do mesmo Wi-Fi, empresa
# ou CGNAT. O de conta é o que barra força bruta num alvo, e deve continuar sendo
# o menor dos dois.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_ACCOUNT_PER_MINUTE=10

# Quem pode criar conta: invite_only (padrão), open ou closed.
# Vale enquanto o administrador não gravar outro valor pela tela — a partir daí a
# tela vence, e ela mostra quais chaves ainda acompanham este arquivo.
REGISTRATION_MODE=invite_only

# Teto de anexos por workspace (bytes). 200 MB.
ATTACHMENT_QUOTA_BYTES=209715200

# Tamanho máximo de um arquivo enviado (bytes). 5 MB.
# O nginx do frontend corta em 6 MB (client_max_body_size), então subir daqui
# além disso não libera nada: a requisição morre antes de chegar ao backend.
UPLOAD_MAX_BYTES=5242880

# Teto de linhas por importação de CSV. É o limite ABSOLUTO do processo — a tela
# de administração só consegue apertá-lo, nunca afrouxá-lo.
IMPORT_MAX_ROWS=5000

# Quem o uvicorn aceita como proxy ao ler `X-Forwarded-For`. Vazio = faixas
# privadas (a rede do Compose), que é o certo para o deploy padrão. Só mexa se o
# backend estiver atrás de um proxy fora dessas faixas — abrir demais devolve ao
# cliente o poder de forjar o próprio IP e o limite por IP deixa de existir.
FORWARDED_ALLOW_IPS=


# ------------------------------------------------------------------------------
# 8) AJUSTES AVANÇADOS  — [OPCIONAL — mantenha os padrões se não precisar]
# ------------------------------------------------------------------------------
# Validade das credenciais emitidas. Alterações valem para novos tokens/cookies.
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7
RESET_TOKEN_EXPIRES_MINUTES=30

# Pool de conexões de CADA processo com o PostgreSQL. Os padrões atendem um
# deploy pequeno/médio; reduza se o servidor de banco tiver limite apertado.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Nunca habilite em produção salvo diagnóstico controlado: registra SQL e pode
# expor parâmetros sensíveis (e-mails, hashes e outros dados) nos logs.
SQL_ECHO=False

# Timeout de CADA tentativa de consulta de câmbio. O look-back pode tentar até
# cinco dias em fins de semana/feriados.
EXCHANGE_RATE_TIMEOUT_SECONDS=4.0

# Fração decimal do IOF para compra internacional no cartão: 0.035 = 3,5%.
# O valor é congelado em cada novo lançamento; mudar não reescreve os antigos.
IOF_INTERNATIONAL_CARD_RATE=0.035
