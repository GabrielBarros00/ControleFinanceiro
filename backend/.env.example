# ==============================================================================
#  CONFIGURAÇÃO DE **DESENVOLVIMENTO LOCAL** (rodar o backend sem Docker)
# ==============================================================================
#  Este arquivo NÃO é usado em produção — o deploy via Docker Compose lê o
#  .env da RAIZ do projeto (veja /.env.example e /SETUP.md).
#
#  Como usar:  cp backend/.env.example backend/.env   e rode:
#      cd backend && python -m uvicorn app.main:app --reload
#
#  Os valores abaixo já funcionam sem alterar nada (SQLite local, sem SMTP,
#  links de email aparecem no console).
# ==============================================================================

# Ambiente dev: cria/ajusta o schema automaticamente no startup (create_all)
APP_ENV=development
APP_VERSION=4.0.0

# Fuso do CALENDÁRIO do app: que dia é "hoje" e onde um mês começa e termina.
# Rodando o uvicorn à mão (fora do compose) não existe `TZ` nenhum definido, e
# antes disto o backend adotava o fuso do processo — UTC no CI.
APP_TIMEZONE=America/Sao_Paulo

# SQLite local — zero setup. (Produção usa Postgres via compose.)
DATABASE_URL=sqlite:///./dev.db

# Em dev pode ser qualquer valor. NUNCA use este valor em produção
# (lá o backend recusa subir com chave fraca).
SECRET_KEY=chave-apenas-para-dev-local
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7

# http://localhost → cookies sem Secure
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# [OPCIONAL] Google OAuth em dev — normalmente deixa vazio
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# [OPCIONAL] Sem SMTP_HOST os links de convite/reset saem no console — ideal em dev
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True

# URL do frontend dev (vite)
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRES_MINUTES=30

# Limites (ver docs/API.md → Rate limiting)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_ACCOUNT_PER_MINUTE=10
UPLOAD_MAX_BYTES=5242880

# Quem pode criar conta (ADR 0026): open | invite_only | closed
#
# Em PRODUÇÃO o padrão é `invite_only` e não se mexe aqui — a tela de Admin
# controla isso em runtime. Em dev fica `open` porque o banco local nasce vazio:
# com o cadastro fechado não haveria como criar a primeira conta, já que
# `SUPERADMIN_EMAIL` (a janela de bootstrap) não é exigido fora de deploy.
REGISTRATION_MODE=open

# [OPCIONAL em dev] E-mail do primeiro superadministrador. Preenchendo, a conta
# com este endereço é promovida no startup e você vê a área de administração
# (/admin) localmente. Vazio = sem administração de plataforma.
SUPERADMIN_EMAIL=
