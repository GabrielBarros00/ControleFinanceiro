# ==============================================================================
#  CONFIGURAÇÃO DE **DESENVOLVIMENTO LOCAL** (rodar o backend sem Docker)
# ==============================================================================
#  Este arquivo NÃO é usado em produção — o deploy via Docker Compose lê o
#  .env da RAIZ do projeto (veja /.env.example e /SETUP.md).
#
#  Como usar:  cp backend/.env.example backend/.env   e rode:
#      cd backend && python -m uvicorn app.main:app --reload
#
#  Os valores abaixo já funcionam sem alterar nada (SQLite local, sem SMTP,
#  links de email aparecem no console).
# ==============================================================================

# Ambiente dev: cria/ajusta o schema automaticamente no startup (create_all)
APP_ENV=development
APP_VERSION=4.0.0

# SQLite local — zero setup. (Produção usa Postgres via compose.)
DATABASE_URL=sqlite:///./dev.db

# Em dev pode ser qualquer valor. NUNCA use este valor em produção
# (lá o backend recusa subir com chave fraca).
SECRET_KEY=chave-apenas-para-dev-local
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7

# http://localhost → cookies sem Secure
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# [OPCIONAL] Google OAuth em dev — normalmente deixa vazio
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# [OPCIONAL] Sem SMTP_HOST os links de convite/reset saem no console — ideal em dev
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True

# URL do frontend dev (vite)
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRES_MINUTES=30

# Limites
RATE_LIMIT_ENABLED=True
UPLOAD_MAX_BYTES=5242880
